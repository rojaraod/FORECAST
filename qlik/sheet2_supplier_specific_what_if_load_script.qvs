/*
Supply Chain Emissions Forecasting - Sheet 2
Multi-Supplier and Supplier-Specific What-If Analysis

Qlik Sense Enterprise native load script for a separate Qlik application using
the same supplied supplier emissions CSV.

Purpose
-------
Build an end-to-end data model for a second dashboard focused on:
1. global additional reduction sensitivity;
2. multi-supplier scenario profiles;
3. supplier-specific reduction adjustment slots for the highest-emission
   suppliers;
4. ESG supply-chain emissions forecast comparison through the net-zero year.

No third-party extensions, writeback services, or custom JavaScript objects are
required. Supplier-specific controls are implemented with Qlik variables mapped
to the top supplier adjustment slots generated during reload.

Source file expected
--------------------
supplier_emissions_source_100_records_c6ee.csv
*/

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0;-$#,##0';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD h:mm:ss[.fff] TT';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;

// Change this connection path to match your Qlik Sense environment.
SET vSourceDataFile=lib://ESG_Source_Data/supplier_emissions_source_100_records_c6ee.csv;

// Global scenario controls.
LET vForecastYear = 2030;
LET vOverallAdditionalReductionPct = 0.12;
LET vExpertJudgementAdjustmentPct = 0.03;
LET vGrowthAdjustmentPct = 0.02;
LET vNetZeroYear = 2050;

// Supplier-specific reduction adjustment variables for the top 20 suppliers by
// current emissions. Values are absolute additional reduction percentages.
// Example: 0.15 means an additional 15 percentage points for that slot.
LET vSupplierReduction01 = 0.15;
LET vSupplierReduction02 = 0.10;
LET vSupplierReduction03 = 0.20;
LET vSupplierReduction04 = 0.20;
LET vSupplierReduction05 = 0.18;
LET vSupplierReduction06 = 0.10;
LET vSupplierReduction07 = 0.10;
LET vSupplierReduction08 = 0.10;
LET vSupplierReduction09 = 0.08;
LET vSupplierReduction10 = 0.08;
LET vSupplierReduction11 = 0.10;
LET vSupplierReduction12 = 0.20;
LET vSupplierReduction13 = 0.10;
LET vSupplierReduction14 = 0.08;
LET vSupplierReduction15 = 0.08;
LET vSupplierReduction16 = 0.18;
LET vSupplierReduction17 = 0.18;
LET vSupplierReduction18 = 0.12;
LET vSupplierReduction19 = 0.10;
LET vSupplierReduction20 = 0.10;

Raw_Supplier_Emissions:
LOAD
    Text(Supplier_Id) AS [Supplier ID],
    Text(Supplier_Name) AS [Supplier Name],
    Text(Industry) AS [Industry],
    Text(Country) AS [Country],
    Num#(Revenue) AS [Revenue],
    Num#(Spend) AS [Spend],
    Num#(Emissions_Year) AS [Current Year],
    Num#(Total_Emissions) AS [Current Emissions],
    Num#(Baseline_Year) AS [Baseline Year],
    Num#(Target_Year) AS [Target Year],
    Num#(Baseline_Emissions) AS [Baseline Emissions],
    If(Len(Trim(Target_Reduction_Pct)) = 0, Null(), Num#(Target_Reduction_Pct)) AS [Supplier Target Reduction Pct],
    Text(Supplier_Forecast_Flag) AS [Supplier Forecast Flag],
    If(
        Len(Trim(Expert_Judgement_Reduction_Percentage)) = 0,
        0,
        Num#(Expert_Judgement_Reduction_Percentage)
    ) AS [Expert Judgement Reduction Pct],
    If(
        Len(Trim(Final_Reduction_Pct)) = 0,
        If(Len(Trim(Target_Reduction_Pct)) = 0, Num#(Expert_Judgement_Reduction_Percentage), Num#(Target_Reduction_Pct)),
        Num#(Final_Reduction_Pct)
    ) AS [Final Reduction Pct],
    Text(Final_Forecast_Method) AS [Forecast Method]
FROM [$(vSourceDataFile)]
(txt, codepage is 65001, embedded labels, delimiter is ',', msq);

Supplier:
NoConcatenate
LOAD
    [Supplier ID],
    [Supplier Name],
    [Industry],
    [Country],
    [Revenue],
    [Spend],
    [Current Year],
    [Current Emissions],
    [Baseline Year],
    [Target Year],
    [Baseline Emissions],
    [Supplier Target Reduction Pct],
    [Supplier Forecast Flag],
    [Expert Judgement Reduction Pct],
    [Final Reduction Pct],
    If([Forecast Method] = 'Expert Judgement', 'Expert Judgement', 'Supplier Target') AS [Forecast Method],
    If(IsNull([Supplier Target Reduction Pct]), 'No supplier target', 'Supplier target available') AS [Target Availability],
    If([Forecast Method] = 'Expert Judgement', 1, 0) AS [Expert Judgement Supplier Flag],
    If([Forecast Method] = 'Supplier Target', 1, 0) AS [Supplier Target Supplier Flag],
    [Current Emissions] / RangeMax(1, [Revenue]) AS [Current Emissions Intensity Revenue],
    [Current Emissions] / RangeMax(1, [Spend]) AS [Current Emissions Intensity Spend],
    RangeMax(0, [Baseline Emissions] - [Current Emissions]) AS [Reduction Since Baseline]
RESIDENT Raw_Supplier_Emissions;

DROP TABLE Raw_Supplier_Emissions;

Forecast_Method_Color:
LOAD * INLINE [
Forecast Method, Forecast Method Color
Supplier Target, #43A047
Expert Judgement, #FB8C00
];

Scenario_Bounds:
LOAD
    Min([Baseline Year]) AS [Scenario Start Year],
    Max([Current Year]) AS [Data Current Year]
RESIDENT Supplier;

LET vScenarioStartYear = Num(Peek('Scenario Start Year', 0, 'Scenario_Bounds'));
LET vDataCurrentYear = Num(Peek('Data Current Year', 0, 'Scenario_Bounds'));

DROP TABLE Scenario_Bounds;

Scenario_Year:
LOAD
    $(vScenarioStartYear) + IterNo() - 1 AS [Scenario Year],
    If(
        $(vScenarioStartYear) + IterNo() - 1 <= $(vDataCurrentYear),
        'Historical',
        'Forecast'
    ) AS [Scenario Period]
AUTOGENERATE 1
WHILE $(vScenarioStartYear) + IterNo() - 1 <= $(vNetZeroYear);

// Multi-supplier scenario profiles are an island table. They let a single line
// chart compare governed scenario assumptions without duplicating supplier rows.
Scenario_Profile:
LOAD
    [Scenario Profile],
    Num#([Scenario Additional Reduction Pct]) AS [Scenario Additional Reduction Pct],
    Num#([Scenario Expert Adjustment Pct]) AS [Scenario Expert Adjustment Pct],
    Num#([Scenario Growth Adjustment Pct]) AS [Scenario Growth Adjustment Pct],
    [Scenario Color],
    [Scenario Sort]
INLINE [
Scenario Profile, Scenario Additional Reduction Pct, Scenario Expert Adjustment Pct, Scenario Growth Adjustment Pct, Scenario Color, Scenario Sort
Current Plan, 0.00, 0.00, 0.00, #0B2E5F, 1
What-if Scenario A - Multi-Supplier, 0.05, 0.03, 0.02, #43A047, 2
Accelerated Supplier Action, 0.10, 0.05, 0.01, #1976D2, 3
High Growth Pressure, 0.03, 0.02, 0.06, #B71C1C, 4
];

// Top supplier adjustment slots. These are linked to Supplier by Supplier ID.
// In the UI, expose vSupplierReduction01 through vSupplierReduction20 as Qlik
// variable controls and use this table to label each slot with the supplier
// generated from the current source data.
Supplier_Adjustment_Slot:
First 20
LOAD
    RowNo() AS [Adjustment Slot],
    [Supplier ID],
    [Supplier Name] AS [Adjustment Supplier Name],
    [Industry] AS [Adjustment Industry],
    [Country] AS [Adjustment Country],
    [Current Emissions] AS [Adjustment Current Emissions],
    [Final Reduction Pct] AS [Default Supplier Reduction Pct],
    'vSupplierReduction' & Num(RowNo(), '00') AS [Supplier Reduction Variable Name],
    [Supplier Name] & ' [' & Num([Final Reduction Pct], '0%') & ']' AS [Supplier Adjustment Label]
RESIDENT Supplier
ORDER BY [Current Emissions] DESC;

Supplier_Group_Bridge:
First 25
LOAD
    [Supplier ID],
    'Top 25 Suppliers' AS [Supplier Group],
    'Highest current emissions suppliers requiring direct intervention' AS [Supplier Group Description]
RESIDENT Supplier
ORDER BY [Current Emissions] DESC;

Concatenate (Supplier_Group_Bridge)
LOAD
    [Supplier ID],
    'Region A Suppliers' AS [Supplier Group],
    'Asia-Pacific supplier intervention portfolio' AS [Supplier Group Description]
RESIDENT Supplier
WHERE Match([Country], 'Australia', 'China', 'India', 'Japan', 'Singapore');

Concatenate (Supplier_Group_Bridge)
LOAD
    [Supplier ID],
    'Region B Suppliers' AS [Supplier Group],
    'Americas and Europe supplier intervention portfolio' AS [Supplier Group Description]
RESIDENT Supplier
WHERE NOT Match([Country], 'Australia', 'China', 'India', 'Japan', 'Singapore');

Concatenate (Supplier_Group_Bridge)
LOAD
    [Supplier ID],
    'Expert Judgement Suppliers' AS [Supplier Group],
    'Suppliers without direct supplier target disclosure' AS [Supplier Group Description]
RESIDENT Supplier
WHERE [Forecast Method] = 'Expert Judgement';

Concatenate (Supplier_Group_Bridge)
LOAD
    [Supplier ID],
    'Supplier Target Suppliers' AS [Supplier Group],
    'Suppliers with supplier target disclosure' AS [Supplier Group Description]
RESIDENT Supplier
WHERE [Forecast Method] = 'Supplier Target';

Concatenate (Supplier_Group_Bridge)
LOAD
    [Supplier ID],
    'All Suppliers' AS [Supplier Group],
    'Complete supplier population' AS [Supplier Group Description]
RESIDENT Supplier;

What_If_Assumptions:
LOAD * INLINE [
Assumption, Variable Name, Default Value, Display Format
Forecast Year, vForecastYear, 2030, 0
Overall Additional Reduction, vOverallAdditionalReductionPct, 0.12, 0.0%
Expert Judgement Adjustment, vExpertJudgementAdjustmentPct, 0.03, 0.0%
Growth Adjustment, vGrowthAdjustmentPct, 0.02, 0.0%
Net Zero Target Year, vNetZeroYear, 2050, 0
];
